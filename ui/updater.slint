// Janela do gestor de atualizações do schematize. Casca visual fina: todos os dados vêm do binário
// `schematize-market` (headless) e todas as ações disparam callbacks tratados no main.rs. Tokens de
// tema copiados da GUI principal (dark ótimo intacto; light rebalanceado pra contraste) pra ficar
// visualmente consistente com o app.

global Th {
    in-out property <bool> dark: true;
    out property <color> bg:          dark ? #14161c : #e8ecf4;
    out property <color> surface:     dark ? #1b1e27 : #ffffff;
    out property <color> surface-2:   dark ? #222634 : #dce3f0;
    out property <color> border:      dark ? #2b3040 : #bfc9dc;
    out property <color> text:        dark ? #e6e9f2 : #12151d;
    out property <color> text-dim:    dark ? #8a90a2 : #475062;
    out property <color> accent:      #5b8cff;
    out property <color> accent-soft: dark ? #2a3a66 : #cedcff;
    out property <color> good:        #3ecf8e;
    out property <color> warn:        #e6b23a;
    out property <color> header-fg:   dark ? #9db4ff : #2b48bd;
}

// Um par rótulo→valor no cartão de status.
component Chip inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <color> value-color: Th.text;
    background: Th.surface-2;
    border-radius: 8px;
    border-width: 1px;
    border-color: Th.border;
    VerticalLayout {
        padding: 10px;
        spacing: 3px;
        Text { text: label; color: Th.text-dim; font-size: 11px; }
        Text { text: value; color: value-color; font-size: 14px; font-weight: 600; overflow: elide; }
    }
}

// Botão custom (mantém o tema; std-widgets traria estilo próprio).
component Btn inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    in property <bool> enabled: true;
    callback clicked();
    height: 40px;
    border-radius: 10px;
    border-width: primary ? 0px : 1px;
    border-color: Th.border;
    background: !enabled ? Th.surface-2
        : primary ? (touch.has-hover ? #6f9bff : Th.accent)
        : (touch.has-hover ? Th.accent-soft : Th.surface);
    opacity: enabled ? 1.0 : 0.5;
    animate background { duration: 120ms; }
    HorizontalLayout {
        padding-left: 18px;
        padding-right: 18px;
        Text {
            text: label;
            vertical-alignment: center;
            horizontal-alignment: center;
            color: primary ? #ffffff : Th.text;
            font-size: 14px;
            font-weight: 600;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

// Uma linha da aba do Mercado. Espelha `mercado::Linha` do Rust — o que a tela ramifica sai
// dos campos de DECISÃO (`categoria`, `instalado`, `metodos`), nunca do `status-texto`, que é
// prosa e muda de idioma.
export struct LinhaMercado {
    slug: string,
    display: string,
    categoria: string,
    metodos: [string],
    metodo-sel: string,
    dica: string,
    instalado: bool,
    status-texto: string,
    titulo-secao: string,
    op-rotulo: string,
}

// Chip de método: clicável, e marcado quando é o selecionado.
component ChipMetodo inherits Rectangle {
    in property <string> label;
    in property <bool> selected: false;
    callback clicked();
    height: 26px;
    width: txt.preferred-width + 22px;
    border-radius: 13px;
    background: selected ? Th.accent-soft : Th.surface-2;
    border-width: 1px;
    border-color: selected ? Th.accent : Th.border;
    txt := Text {
        text: label;
        color: selected ? Th.text : Th.text-dim;
        font-size: 12px;
        font-weight: selected ? 700 : 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    TouchArea { clicked => { root.clicked(); } mouse-cursor: pointer; }
}

// A ABA DO MERCADO. Veio do hub (`screen_envs.slint`) com o comportamento intacto: três
// seções, chip de método só onde há método, e sem botão de remover na seção de apps da casa.
//
// A ausência do "remover" nos apps é deliberada e espelha o que o próprio market responde: app
// da casa não se desinstala por um comando genérico — cada um tem o seu, que sabe da entrada de
// desktop, do ícone e do estado em `~`. Apagar só o binário daqui deixaria o ícone órfão no
// menu, e um ícone que abre nada é pior que um app instalado.
// Não exportada: só o `MainWindow` a usa, e exportar um componente que não é janela faz o
// compilador do Slint avisar que não gera código para ela.
component TelaMercado inherits VerticalLayout {
    in property <[LinhaMercado]> linhas;
    // Por que o mercado não pôde ser lido. Vazio = deu certo.
    in property <string> erro;
    in property <bool> carregando: false;
    callback escolher-metodo(int, string);
    callback instalar(int);
    callback remover(int);
    callback recarregar();

    // Cabeçalho da aba: o que ela é, e o botão de reler.
    Rectangle {
        height: 52px;
        background: Th.bg;
        HorizontalLayout {
            padding-left: 4px;
            padding-right: 4px;
            spacing: 12px;
            VerticalLayout {
                alignment: center;
                Text {
                    text: "Linguagens, ferramentas de dev e os apps da casa.";
                    font-size: 12.5px;
                    color: Th.text-dim;
                    wrap: word-wrap;
                }
            }
            Rectangle { horizontal-stretch: 1; }
            VerticalLayout {
                alignment: center;
                Btn {
                    label: root.carregando ? "lendo…" : "Recarregar";
                    enabled: !root.carregando;
                    clicked => { root.recarregar(); }
                }
            }
        }
    }
    Rectangle { height: 1px; background: Th.border; }

    // O ERRO É TELA, não ausência. Sem isto, um market ausente daria uma lista vazia — que a
    // pessoa leria como "o mercado não tem nada", em vez de "não consegui falar com o gestor".
    // Foi essa confusão entre "não sei" e "não tem" que quebrou esta janela uma vez.
    if root.erro != "": Rectangle {
        background: Th.surface;
        border-radius: 12px;
        border-width: 1px;
        border-color: Th.warn;
        vertical-stretch: 1;
        VerticalLayout {
            padding: 20px;
            spacing: 10px;
            alignment: center;
            Text {
                text: "Não consegui ler o mercado";
                color: Th.warn;
                font-size: 15px;
                font-weight: 700;
                horizontal-alignment: center;
            }
            Text {
                text: root.erro;
                color: Th.text-dim;
                font-size: 12px;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
            Text {
                text: "Instale o gestor com:\n  cargo install --git https://github.com/schematizeme/schematize_market_rs";
                color: Th.text-dim;
                font-size: 12px;
                font-family: "monospace";
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }
    }

    if root.erro == "": Flickable {
        vertical-stretch: 1;
        viewport-width: self.width;
        viewport-height: lista.preferred-height;
        lista := VerticalLayout {
            width: parent.width;
            padding: 8px;
            spacing: 10px;
            for row[i] in root.linhas: VerticalLayout {
                spacing: 10px;
                if row.titulo-secao != "": Text {
                    text: row.titulo-secao;
                    font-size: 13px;
                    font-weight: 700;
                    color: Th.text-dim;
                }
                Rectangle {
                    height: 92px;
                    border-radius: 12px;
                    background: Th.surface;
                    border-width: 1px;
                    border-color: Th.border;
                    VerticalLayout {
                        padding: 12px;
                        spacing: 8px;
                        // linha 1: nome + pílula de status
                        HorizontalLayout {
                            spacing: 12px;
                            Text {
                                text: row.display;
                                font-size: 15px;
                                font-weight: 700;
                                color: Th.text;
                                vertical-alignment: center;
                            }
                            // A pílula só existe quando há o que escrever nela. Um oval
                            // colorido com nada dentro não diz nada, e é pior que não desenhar
                            // pílula nenhuma — foi o que se viu contra um market antigo, antes
                            // de o `status_texto` ganhar as duas quedas do lado do Rust.
                            if row.status-texto != "": Rectangle {
                                y: (parent.height - self.height) / 2;
                                height: 24px;
                                width: pilula.preferred-width + 22px;
                                border-radius: 12px;
                                property <color> tom: row.instalado ? Th.good : Th.text-dim;
                                background: tom.transparentize(0.85);
                                border-width: 1px;
                                border-color: tom.transparentize(0.5);
                                pilula := Text {
                                    text: row.status-texto;
                                    color: row.instalado ? Th.good : Th.text-dim;
                                    font-size: 12px;
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                            Rectangle { horizontal-stretch: 1; }
                            if row.op-rotulo != "": Text {
                                text: row.op-rotulo;
                                font-size: 12px;
                                font-weight: 600;
                                color: Th.text-dim;
                                vertical-alignment: center;
                            }
                        }
                        // linha 2 — LINGUAGEM: chips de método + instalar/remover.
                        //
                        // A condição é `== "language"`, e não `!= "tool"`. Com a negação, a
                        // seção de apps da casa caía aqui: como app não tem método, a linha
                        // diria "sem método" e o botão de instalar ficaria DESABILITADO — um
                        // app instalável que a tela apresenta como impossível. O hub já teve
                        // esse bug, e a condição positiva é o conserto que veio junto.
                        if row.categoria == "language": HorizontalLayout {
                            spacing: 8px;
                            VerticalLayout {
                                alignment: center;
                                Text { text: "via"; font-size: 12.5px; color: Th.text-dim; }
                            }
                            for m in row.metodos: VerticalLayout {
                                alignment: center;
                                ChipMetodo {
                                    label: m;
                                    selected: m == row.metodo-sel;
                                    clicked => { root.escolher-metodo(i, m); }
                                }
                            }
                            if row.metodos.length == 0: VerticalLayout {
                                alignment: center;
                                Text {
                                    text: "sem método disponível";
                                    font-size: 12.5px;
                                    color: Th.warn;
                                }
                            }
                            Rectangle { horizontal-stretch: 1; }
                            VerticalLayout {
                                alignment: center;
                                Btn {
                                    label: row.instalado ? "Trocar" : "Instalar";
                                    primary: true;
                                    enabled: row.metodos.length > 0 && row.metodo-sel != "";
                                    clicked => { root.instalar(i); }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                Btn {
                                    label: "Remover";
                                    enabled: row.instalado;
                                    clicked => { root.remover(i); }
                                }
                            }
                        }
                        // linha 2 — FERRAMENTA: sem chips; a dica diz por onde ela entra.
                        if row.categoria == "tool": HorizontalLayout {
                            spacing: 8px;
                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: row.dica;
                                    font-size: 12.5px;
                                    color: Th.text-dim;
                                }
                            }
                            Rectangle { horizontal-stretch: 1; }
                            VerticalLayout {
                                alignment: center;
                                Btn {
                                    label: "Instalar";
                                    primary: true;
                                    enabled: !row.instalado;
                                    clicked => { root.instalar(i); }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                Btn {
                                    label: "Remover";
                                    enabled: row.instalado;
                                    clicked => { root.remover(i); }
                                }
                            }
                        }
                        // linha 2 — APP DA CASA: sem método e SEM remover (ver o topo).
                        if row.categoria == "app": HorizontalLayout {
                            spacing: 8px;
                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: row.dica;
                                    font-size: 12.5px;
                                    color: Th.text-dim;
                                    wrap: word-wrap;
                                }
                            }
                            Rectangle { horizontal-stretch: 1; }
                            VerticalLayout {
                                alignment: center;
                                Btn {
                                    label: "Instalar";
                                    primary: true;
                                    enabled: !row.instalado;
                                    clicked => { root.instalar(i); }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "schematize · gestor de atualizações";
    preferred-width: 740px;
    preferred-height: 580px;
    min-width: 560px;
    min-height: 460px;
    background: Th.bg;

    in-out property <bool> dark <=> Th.dark;
    in-out property <string> gestor-ver: "—";
    in-out property <string> app-installed: "—";
    in-out property <string> app-latest: "—";
    in-out property <string> platform: "—";
    in-out property <string> binready: "—";
    in-out property <string> instdir: "—";
    in-out property <string> pin: "";
    in-out property <bool> has-update: false;
    in-out property <bool> app-missing: false;
    // Sem contato com o `schematize-market`: NÃO é o mesmo que "app não instalado", e a
    // janela não pode afirmar uma coisa quando o que houve foi a outra.
    in-out property <bool> gestor-ausente: false;
    in-out property <bool> busy: false;
    in-out property <string> action-label: "Atualizar";
    in-out property <string> status-line: "";
    in-out property <string> log: "";

    // Aba ativa: 0 = Atualizações, 1 = Mercado.
    in-out property <int> aba: 0;
    in-out property <[LinhaMercado]> mercado-linhas;
    in-out property <string> mercado-erro: "";
    in-out property <bool> mercado-carregando: false;

    callback do-primary();
    callback do-launch();
    callback refresh();
    callback toggle-theme();
    callback mercado-recarregar();
    callback mercado-escolher-metodo(int, string);
    callback mercado-instalar(int);
    callback mercado-remover(int);

    VerticalLayout {
        padding: 20px;
        spacing: 16px;

        // ---- Cabeçalho ----
        HorizontalLayout {
            spacing: 10px;
            VerticalLayout {
                Text {
                    text: "Gestor de atualizações";
                    color: Th.header-fg;
                    font-size: 20px;
                    font-weight: 800;
                }
                Text {
                    text: "schematize-market " + root.gestor-ver + "  ·  " + root.platform;
                    color: Th.text-dim;
                    font-size: 12px;
                }
            }
            Rectangle { horizontal-stretch: 1; }
            // status geral (bolinha + texto)
            HorizontalLayout {
                spacing: 8px;
                Rectangle {
                    width: 10px; height: 10px; border-radius: 5px;
                    background: root.gestor-ausente ? Th.warn
                        : (root.app-missing ? Th.warn : (root.has-update ? Th.accent : Th.good));
                }
                Text {
                    vertical-alignment: center;
                    text: root.gestor-ausente ? "sem contato com o gestor"
                        : root.app-missing ? "app não instalado"
                        : (root.has-update ? "atualização disponível" : "em dia");
                    color: Th.text;
                    font-size: 13px;
                    font-weight: 600;
                }
            }
        }

        // ---- Abas ----
        //
        // Duas, e não um menu: são duas telas, e um seletor com dois itens que se esconde é
        // mais clique para o mesmo lugar. A aba do Mercado só LÊ ao ser aberta pela primeira
        // vez (o `mercado-recarregar` do clique), porque `list --json` sonda a máquina inteira
        // e fazer isso na abertura atrasaria a janela que existe justamente para abrir rápido.
        HorizontalLayout {
            spacing: 8px;
            Btn {
                label: "Atualizações";
                primary: root.aba == 0;
                clicked => { root.aba = 0; }
            }
            Btn {
                label: "Mercado";
                primary: root.aba == 1;
                clicked => {
                    root.aba = 1;
                    // Lê só na primeira vez: `list --json` sonda a máquina inteira, e refazer
                    // isso a cada troca de aba faria a janela travar por meio segundo à toa.
                    // Quem quiser reler tem o botão "Recarregar" na própria aba.
                    if (root.mercado-linhas.length == 0 && root.mercado-erro == "") {
                        root.mercado-recarregar();
                    }
                }
            }
            Rectangle { horizontal-stretch: 1; }
            Btn {
                label: root.dark ? "☾" : "☀";
                clicked => { root.toggle-theme(); }
            }
        }

        // ---- ABA MERCADO ----
        if root.aba == 1: TelaMercado {
            vertical-stretch: 1;
            linhas: root.mercado-linhas;
            erro: root.mercado-erro;
            carregando: root.mercado-carregando;
            recarregar => { root.mercado-recarregar(); }
            escolher-metodo(i, m) => { root.mercado-escolher-metodo(i, m); }
            instalar(i) => { root.mercado-instalar(i); }
            remover(i) => { root.mercado-remover(i); }
        }

        // ---- Cartão de status ----
        if root.aba == 0: Rectangle {
            background: Th.surface;
            border-radius: 14px;
            border-width: 1px;
            border-color: Th.border;
            VerticalLayout {
                padding: 14px;
                spacing: 10px;
                HorizontalLayout {
                    spacing: 10px;
                    Chip {
                        label: "App instalado";
                        value: root.app-missing ? "nenhum" : root.app-installed;
                        value-color: root.app-missing ? Th.warn : Th.text;
                        horizontal-stretch: 1;
                    }
                    Chip {
                        label: "Última publicada";
                        value: root.app-latest;
                        value-color: root.has-update ? Th.accent : Th.text;
                        horizontal-stretch: 1;
                    }
                    Chip {
                        label: "Binário pronto?";
                        value: root.binready;
                        horizontal-stretch: 1;
                    }
                }
                if root.pin != "": Text {
                    text: "versão fixada (pin): " + root.pin;
                    color: Th.warn;
                    font-size: 12px;
                }
                Text {
                    text: "instala em: " + root.instdir;
                    color: Th.text-dim;
                    font-size: 11px;
                    overflow: elide;
                }
            }
        }

        // ---- Ações ----
        if root.aba == 0: HorizontalLayout {
            spacing: 10px;
            Btn {
                label: root.busy ? "trabalhando…" : root.action-label;
                primary: true;
                enabled: !root.busy;
                horizontal-stretch: 2;
                clicked => { root.do-primary(); }
            }
            Btn {
                label: "Abrir app";
                enabled: !root.busy && !root.app-missing;
                horizontal-stretch: 1;
                clicked => { root.do-launch(); }
            }
            Btn {
                label: "Rechecar";
                enabled: !root.busy;
                clicked => { root.refresh(); }
            }
        }

        if root.aba == 0 && root.status-line != "": Text {
            text: root.status-line;
            color: Th.text-dim;
            font-size: 12px;
        }

        // ---- Log ao vivo ----
        if root.aba == 0: Rectangle {
            vertical-stretch: 1;
            background: Th.dark ? #0e1015 : #f4f7fc;
            border-radius: 12px;
            border-width: 1px;
            border-color: Th.border;
            clip: true;
            Flickable {
                x: 0; y: 0;
                width: parent.width;
                height: parent.height;
                viewport-width: self.width;
                viewport-height: logtext.preferred-height + 24px;
                // auto-follow: quando o conteúdo passa da altura visível, rola pro fim.
                viewport-y: min(0px, self.height - (logtext.preferred-height + 24px));
                logtext := Text {
                    x: 12px; y: 12px;
                    width: parent.width - 24px;
                    text: root.log == "" ? "pronto. clique em «" + root.action-label + "» pra começar." : root.log;
                    color: Th.text-dim;
                    font-size: 12px;
                    font-family: "monospace";
                    wrap: word-wrap;
                }
            }
        }
    }
}
